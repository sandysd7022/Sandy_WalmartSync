<?xml version="1.0"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">sandy_walmartsync_sku_listing.sandy_walmartsync_sku_listing_data_source</item>
            <item name="deps" xsi:type="string">sandy_walmartsync_sku_listing.sandy_walmartsync_sku_listing_data_source</item>
        </item>
        <item name="spinner" xsi:type="string">walmart_sku_columns</item>
    </argument>
    <dataSource name="sandy_walmartsync_sku_listing_data_source">
        <argument name="dataProvider" xsi:type="configurableObject">
            <argument name="class" xsi:type="string">Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider</argument>
            <argument name="name" xsi:type="string">sandy_walmartsync_sku_listing_data_source</argument>
            <argument name="primaryFieldName" xsi:type="string">entity_id</argument>
            <argument name="requestFieldName" xsi:type="string">id</argument>
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="component" xsi:type="string">Magento_Ui/js/grid/provider</item>
                    <item name="update_url" xsi:type="url" path="mui/index/render"/>
                    <item name="storageConfig" xsi:type="array">
                        <item name="indexField" xsi:type="string">entity_id</item>
                    </item>
                </item>
            </argument>
        </argument>
    </dataSource>
    <listingToolbar name="listing_top">
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filters name="listing_filters"/>
        <massaction name="listing_massaction">
            <action name="verify_mapping">
                <settings>
                    <type>verify_mapping</type>
                    <label translate="true">Verify Selected Custom-Option Mappings</label>
                    <url path="sandy_walmartsync/sku/massVerifyMapping"/>
                    <confirm>
                        <title translate="true">Verify selected mappings?</title>
                        <message translate="true">Confirm that each selected Walmart custom-option SKU points to the correct Magento parent and option. This changes local controls only and does not contact Walmart.</message>
                    </confirm>
                </settings>
            </action>
            <action name="enable_product_sync">
                <settings>
                    <type>enable_product_sync</type>
                    <label translate="true">Enable Sync for Selected Magento Products</label>
                    <url path="sandy_walmartsync/sku/massProductSync/enabled/1"/>
                    <confirm>
                        <title translate="true">Enable selected products?</title>
                        <message translate="true">This enables the unique mapped Magento parent products. It does not send inventory until global writes and an execution process are enabled.</message>
                    </confirm>
                </settings>
            </action>
            <action name="disable_product_sync">
                <settings>
                    <type>disable_product_sync</type>
                    <label translate="true">Disable Sync for Selected Magento Products</label>
                    <url path="sandy_walmartsync/sku/massProductSync/enabled/0"/>
                    <confirm>
                        <title translate="true">Disable selected products?</title>
                        <message translate="true">Selected mapped parent products will be skipped by future synchronization. This action does not send zero or contact Walmart.</message>
                    </confirm>
                </settings>
            </action>
        </massaction>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="walmart_sku_columns">
        <selectionsColumn name="ids"><settings><indexField>entity_id</indexField></settings></selectionsColumn>
        <column name="walmart_sku"><settings><filter>text</filter><label translate="true">Walmart SKU</label></settings></column>
        <column name="item_id"><settings><filter>text</filter><visible>false</visible><label translate="true">Item ID</label></settings></column>
        <column name="product_name"><settings><filter>text</filter><label translate="true">Walmart Product</label></settings></column>
        <column name="current_qty">
            <argument name="data" xsi:type="array"><item name="config" xsi:type="array"><item name="fieldClass" xsi:type="array"><item name="walmart-cell-control" xsi:type="boolean">true</item></item></item></argument>
            <settings><filter>textRange</filter><label translate="true">Last Known Qty</label></settings>
        </column>
        <column name="magento_sku">
            <argument name="data" xsi:type="array"><item name="config" xsi:type="array"><item name="fieldClass" xsi:type="array"><item name="walmart-cell-control" xsi:type="boolean">true</item></item></item></argument>
            <settings><filter>text</filter><label translate="true">Magento SKU</label></settings>
        </column>
        <column name="mapping_type">
            <argument name="data" xsi:type="array"><item name="config" xsi:type="array"><item name="fieldClass" xsi:type="array"><item name="walmart-cell-mapping" xsi:type="boolean">true</item></item></item></argument>
            <settings><filter>text</filter><label translate="true">Mapping Type</label></settings>
        </column>
        <column name="option_title"><settings><filter>text</filter><label translate="true">Magento Option</label></settings></column>
        <column name="mapping_verified" component="Magento_Ui/js/grid/columns/select">
            <argument name="data" xsi:type="array"><item name="config" xsi:type="array"><item name="fieldClass" xsi:type="array"><item name="walmart-cell-mapping" xsi:type="boolean">true</item></item></item></argument>
            <settings>
                <options class="Magento\Config\Model\Config\Source\Yesno"/>
                <filter>select</filter><dataType>select</dataType><label translate="true">Mapping Verified</label>
            </settings>
        </column>
        <column name="sync_enabled" component="Magento_Ui/js/grid/columns/select">
            <argument name="data" xsi:type="array"><item name="config" xsi:type="array"><item name="fieldClass" xsi:type="array"><item name="walmart-cell-control" xsi:type="boolean">true</item></item></item></argument>
            <settings>
                <options class="Magento\Config\Model\Config\Source\Yesno"/>
                <filter>select</filter><dataType>select</dataType><label translate="true">Sync Enabled</label>
            </settings>
        </column>
        <column name="magento_qty_live">
            <argument name="data" xsi:type="array"><item name="config" xsi:type="array"><item name="fieldClass" xsi:type="array"><item name="walmart-cell-control" xsi:type="boolean">true</item></item></item></argument>
            <settings><filter>textRange</filter><label translate="true">Magento Qty</label></settings>
        </column>
        <column name="is_meltable" component="Magento_Ui/js/grid/columns/select">
            <argument name="data" xsi:type="array"><item name="config" xsi:type="array"><item name="fieldClass" xsi:type="array"><item name="walmart-cell-control" xsi:type="boolean">true</item></item></item></argument>
            <settings>
                <options class="Magento\Config\Model\Config\Source\Yesno"/>
                <filter>select</filter><dataType>select</dataType><label translate="true">Meltable</label>
            </settings>
        </column>
        <column name="seasonal_status">
            <argument name="data" xsi:type="array"><item name="config" xsi:type="array"><item name="fieldClass" xsi:type="array"><item name="walmart-cell-control" xsi:type="boolean">true</item></item></item></argument>
            <settings><filter>text</filter><label translate="true">Seasonal Status</label></settings>
        </column>
        <column name="calculated_qty">
            <argument name="data" xsi:type="array"><item name="config" xsi:type="array"><item name="fieldClass" xsi:type="array"><item name="walmart-cell-control" xsi:type="boolean">true</item></item></item></argument>
            <settings><filter>textRange</filter><label translate="true">Calculated Walmart Qty</label></settings>
        </column>
        <column name="sync_action">
            <argument name="data" xsi:type="array"><item name="config" xsi:type="array"><item name="fieldClass" xsi:type="array"><item name="walmart-cell-control" xsi:type="boolean">true</item></item></item></argument>
            <settings><filter>text</filter><label translate="true">Sync Action</label></settings>
        </column>
        <column name="is_eligible" component="Magento_Ui/js/grid/columns/select">
            <argument name="data" xsi:type="array"><item name="config" xsi:type="array"><item name="fieldClass" xsi:type="array"><item name="walmart-cell-mapping" xsi:type="boolean">true</item></item></item></argument>
            <settings>
                <options class="Magento\Config\Model\Config\Source\Yesno"/>
                <filter>select</filter><dataType>select</dataType><label translate="true">Ready to Sync</label>
            </settings>
        </column>
        <column name="eligibility_reason">
            <argument name="data" xsi:type="array"><item name="config" xsi:type="array"><item name="fieldClass" xsi:type="array"><item name="walmart-cell-mapping" xsi:type="boolean">true</item></item></item></argument>
            <settings><filter>text</filter><label translate="true">Eligibility Reason</label></settings>
        </column>
        <column name="sku_exemption_status">
            <argument name="data" xsi:type="array"><item name="config" xsi:type="array"><item name="fieldClass" xsi:type="array"><item name="walmart-cell-reference" xsi:type="boolean">true</item></item></item></argument>
            <settings><filter>text</filter><visible>false</visible><label translate="true">Exemption History</label></settings>
        </column>
        <column name="published_status" component="Magento_Ui/js/grid/columns/select">
            <argument name="data" xsi:type="array"><item name="config" xsi:type="array"><item name="fieldClass" xsi:type="array"><item name="walmart-cell-mapping" xsi:type="boolean">true</item></item></item></argument>
            <settings>
                <options class="Sandy\WalmartSync\Model\Config\Source\PublishedStatus"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <visible>false</visible>
                <label translate="true">Published Status</label>
            </settings>
        </column>
        <column name="last_sync_status">
            <argument name="data" xsi:type="array"><item name="config" xsi:type="array"><item name="fieldClass" xsi:type="array"><item name="walmart-cell-result" xsi:type="boolean">true</item></item></item></argument>
            <settings><filter>text</filter><label translate="true">Last Result</label></settings>
        </column>
        <column name="last_error">
            <argument name="data" xsi:type="array"><item name="config" xsi:type="array"><item name="fieldClass" xsi:type="array"><item name="walmart-cell-result" xsi:type="boolean">true</item></item></item></argument>
            <settings><filter>text</filter><label translate="true">Last Error</label></settings>
        </column>
        <column name="last_synced_at" class="Magento\Ui\Component\Listing\Columns\Date">
            <argument name="data" xsi:type="array"><item name="config" xsi:type="array"><item name="fieldClass" xsi:type="array"><item name="walmart-cell-control" xsi:type="boolean">true</item></item></item></argument>
            <settings><filter>dateRange</filter><dataType>date</dataType><label translate="true">Last Sync Time</label></settings>
        </column>
        <column name="updated_at" class="Magento\Ui\Component\Listing\Columns\Date">
            <argument name="data" xsi:type="array"><item name="config" xsi:type="array"><item name="fieldClass" xsi:type="array"><item name="walmart-cell-reference" xsi:type="boolean">true</item></item></item></argument>
            <settings><filter>dateRange</filter><dataType>date</dataType><visible>false</visible><label translate="true">Updated</label></settings>
        </column>
    </columns>
</listing>
