<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Framework\Console\CommandList">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="walmart_connection_test" xsi:type="object">Sandy\WalmartSync\Console\Command\ConnectionTestCommand</item>
                <item name="walmart_catalog_import" xsi:type="object">Sandy\WalmartSync\Console\Command\CatalogImportCommand</item>
                <item name="walmart_catalog_diagnose" xsi:type="object">Sandy\WalmartSync\Console\Command\CatalogDiagnoseCommand</item>
                <item name="walmart_catalog_reconcile" xsi:type="object">Sandy\WalmartSync\Console\Command\CatalogReconcileCommand</item>
                <item name="walmart_sku_configure" xsi:type="object">Sandy\WalmartSync\Console\Command\SkuConfigureCommand</item>
                <item name="walmart_exemption_export" xsi:type="object">Sandy\WalmartSync\Console\Command\ExemptionExportCommand</item>
                <item name="walmart_exemption_import" xsi:type="object">Sandy\WalmartSync\Console\Command\ExemptionImportCommand</item>
                <item name="walmart_inventory_backup" xsi:type="object">Sandy\WalmartSync\Console\Command\InventoryBackupCommand</item>
                <item name="walmart_inventory_preview" xsi:type="object">Sandy\WalmartSync\Console\Command\InventoryPreviewCommand</item>
                <item name="walmart_inventory_zero" xsi:type="object">Sandy\WalmartSync\Console\Command\InventoryZeroCommand</item>
                <item name="walmart_inventory_sync" xsi:type="object">Sandy\WalmartSync\Console\Command\InventorySyncCommand</item>
                <item name="walmart_item_feed" xsi:type="object">Sandy\WalmartSync\Console\Command\ItemFeedCommand</item>
                <item name="walmart_item_feed_generate_simple" xsi:type="object">Sandy\WalmartSync\Console\Command\ItemFeedGenerateCommand</item>
                <item name="walmart_item_feed_status" xsi:type="object">Sandy\WalmartSync\Console\Command\ItemFeedStatusCommand</item>
            </argument>
        </arguments>
    </type>
    <type name="Sandy\WalmartSync\Model\ResourceModel\WalmartSku\Grid\Collection">
        <arguments>
            <argument name="mainTable" xsi:type="string">sandy_walmartsync_sku</argument>
            <argument name="resourceModel" xsi:type="string">Sandy\WalmartSync\Model\ResourceModel\WalmartSku</argument>
        </arguments>
    </type>
    <type name="Sandy\WalmartSync\Model\ResourceModel\ItemCandidate\Grid\Collection">
        <arguments>
            <argument name="mainTable" xsi:type="string">sandy_walmartsync_item_candidate</argument>
            <argument name="resourceModel" xsi:type="string">Sandy\WalmartSync\Model\ResourceModel\ItemCandidate</argument>
            <argument name="identifierName" xsi:type="string">entity_id</argument>
        </arguments>
    </type>
    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="sandy_walmartsync_sku_listing_data_source" xsi:type="string">Sandy\WalmartSync\Model\ResourceModel\WalmartSku\Grid\Collection</item>
                <item name="sandy_walmartsync_item_listing_data_source" xsi:type="string">Sandy\WalmartSync\Model\ResourceModel\ItemCandidate\Grid\Collection</item>
            </argument>
        </arguments>
    </type>
</config>
